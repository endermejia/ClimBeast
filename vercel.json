{
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "dist/climbeast/browser",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/8anu/:path*", "destination": "https://www.8a.nu/:path*" },
    {
      "source": "/api/desnivel/(.*)",
      "destination": "/api/desnivel?path=$1"
    },
    { "source": "/(.*)", "destination": "/" }
  ]
}
